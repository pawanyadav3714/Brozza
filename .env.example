# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Razorpay Payment Gateway Configuration
# VITE_RAZORPAY_KEY_ID: Public API Key ID (Format: rzp_test_... for test mode, or rzp_live_... for production)
VITE_RAZORPAY_KEY_ID="rzp_live_TeMHfOItsnQoDS"

# RAZORPAY_KEY_SECRET: Private Key Secret (Keep confidential)
RAZORPAY_KEY_SECRET="J40xvVKF1sQkqXs3UB5p54dH"
VITE_RAZORPAY_KEY_SECRET="J40xvVKF1sQkqXs3UB5p54dH"
