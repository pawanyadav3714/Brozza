rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'pawanyadav3714@gmail.com' ||
        request.auth.token.email != null
      );
    }

    // Dishes Collection: Real-time menu synchronization between Customer App & Admin Dashboard (brozza-admin.vercel.app)
    match /dishes/{dishId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /menu/{dishId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Orders Collection: Real-time synchronization between Customer App & Admin Dashboard (brozza-admin.vercel.app)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update: if isSignedIn() || true;
      allow delete: if isSignedIn() || true;
    }

    // Parcels Collection: Real-time express courier sync
    match /parcels/{parcelId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update: if isSignedIn() || true;
      allow delete: if isSignedIn() || true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
